# swain-helm test environment variables
# -------------------------------------------
# For tests that require Zulip credentials, use op run:
#   op run --env-file=.env.test -- docker compose -f docker-compose.test.yml up test-e2e
#
# Replace the op:// references below with your actual 1Password vault paths.

ZULIP_BOT_EMAIL=op://Private/Zulip Bot - swain-helm/username
ZULIP_BOT_API_KEY=op://Private/Zulip Bot - swain-helm/credential
ZULIP_SITE=https://cristoslc.zulipchat.com
ZULIP_OPERATOR_EMAIL=cristos@cristoslc.com