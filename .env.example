# swain-helm Docker environment variables
# ----------------------------------------
# Copy this file to .env and fill in your values.
# Or use 1Password with op:// references.

# Project configuration (required)
PROJECT_PATH=/path/to/your/project
PROJECT_NAME=your-project

# Zulip credentials (required)
ZULIP_BOT_EMAIL=your-bot@yourorg.zulipchat.com
ZULIP_BOT_API_KEY=your-api-key
ZULIP_SITE=https://yourorg.zulipchat.com
ZULIP_OPERATOR_EMAIL=you@example.com

# Using 1Password instead of plaintext:
# ZULIP_BOT_EMAIL=op://Private/Zulip Bot/username
# ZULIP_BOT_API_KEY=op://Private/Zulip Bot/credential
# ZULIP_SITE=op://Private/Zulip Bot/site
# ZULIP_OPERATOR_EMAIL=op://Private/Zulip Bot/operator